# ─────────────────────────────────────────────────────────────────────────────
# digest-agent Next.js UI — environment variables
# Copy to .env.local for local development:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# SQLite location. Use a `file:` URL.
#   • Local dev (workspace-relative):     file:./data/digest.db
#   • Container / production (absolute):  file:/data/digest.db
# In production, Litestream replicates /data/digest.db to GCS.
DATABASE_URL=file:./data/digest.db

# Optional: raw path override (highest priority). Useful for tests.
#   DATABASE_PATH=:memory:

# ── Litestream (production only) ────────────────────────────────────────────
# When set, the container entrypoint restores from gs://$LITESTREAM_GCS_BUCKET/
# digest-db on cold start and replicates WAL writes back every 10s.
# Leave unset for local dev — the app falls back to ephemeral SQLite.
# LITESTREAM_GCS_BUCKET=my-digest-agent-data

# ── LLM provider ────────────────────────────────────────────────────────────
# One of: gemini | anthropic
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini. Get one at:
#   https://aistudio.google.com/app/apikey
# Use a value starting with "test-" to force mock mode.
GEMINI_API_KEY=your-gemini-api-key-here

# Required when LLM_PROVIDER=anthropic.
# Use a value starting with "test-" to force mock mode.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Server-side API base URL (for internal fetches) ─────────────────────────
# When the API needs to call its own routes server-side. Optional in dev.
# NEXTAUTH_URL=http://localhost:3000

# ── Publish channels (optional) ─────────────────────────────────────────────
# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord
# DISCORD_WEBHOOK_URL=
