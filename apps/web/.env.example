# ─────────────────────────────────────────────────────────────────────────────
# digest-agent Next.js UI — environment variables
# Copy to .env.local for local development:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# SQLite location. Use a `file:` URL.
#   • Local dev (workspace-relative):     file:./data/digest.db
#   • Container / production (absolute):  file:/data/digest.db
# In production, Litestream replicates /data/digest.db to GCS.
DATABASE_URL=file:./data/digest.db

# Optional: raw path override (highest priority). Useful for tests.
#   DATABASE_PATH=:memory:

# ── Litestream (production only) ────────────────────────────────────────────
# When set, the container entrypoint restores from gs://$LITESTREAM_GCS_BUCKET/
# digest-db on cold start and replicates WAL writes back every 10s.
# Leave unset for local dev — the app falls back to ephemeral SQLite.
# LITESTREAM_GCS_BUCKET=my-digest-agent-data

# ── LLM provider ────────────────────────────────────────────────────────────
# One of: gemini | anthropic
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini. Get one at:
#   https://aistudio.google.com/app/apikey
# Use a value starting with "test-" to force mock mode.
GEMINI_API_KEY=your-gemini-api-key-here

# Required when LLM_PROVIDER=anthropic.
# Use a value starting with "test-" to force mock mode.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Server-side API base URL (for internal fetches) ─────────────────────────
# When the API needs to call its own routes server-side. Optional in dev.
# NEXTAUTH_URL=http://localhost:3000

# ── HTTP Basic Auth gate (production) ───────────────────────────────────────
# Cloud Run UI is publicly reachable; middleware.ts enforces basic auth on
# every request except /api/health. Defaults are admin/digest2026bwaijimmy
# — ROTATE for production by editing .env.deploy then re-running:
#   make deploy-web
# (Cloud Run env vars are baked per-revision — no hot-reload.)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=digest2026bwaijimmy

# Disable the gate entirely (local dev only — never set this on Cloud Run!):
# BASIC_AUTH_DISABLED=1

# ── GEAP / Vertex AI Reasoning Engine (for /stock-analysis) ─────────────────
# Resource name from `make list-agent-engines`. /api/stock-chat proxies
# user messages to this engine via streamQuery.
# GEAP_RESOURCE_NAME=projects/PROJECT_ID/locations/us-central1/reasoningEngines/NNNNNN

# ── Publish channels (optional) ─────────────────────────────────────────────
# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord
# DISCORD_WEBHOOK_URL=
