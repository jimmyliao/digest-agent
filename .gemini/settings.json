{
  "general": {
    "checkpointing": {
      "enabled": true
    }
  },
  "hooks": {
    "BeforeTool": [
      {
        "command": "bash",
        "args": [
          ".gemini/hooks/guard_rails.sh"
        ],
        "comment": "攔截對 data/ 和 app.py 的危險操作"
      },
      {
        "command": "node",
        "args": [
          ".gemini/hooks/app-protection.js"
        ],
        "comment": "防止 rm/mv src/app.py"
      }
    ],
    "BeforeModel": [
      {
        "command": "bash",
        "args": [
          "scripts/sys-load.sh"
        ],
        "comment": "注入即時 CPU 負載到 context（跨平台：macOS + Linux/Cloud Shell）"
      }
    ]
  },
  "mcpServers": {
    "github": {
      "url": "https://gitmcp.io/jimmyliao/digest-agent"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "cloudrun": {
      "command": "npx",
      "args": [
        "-y",
        "@google/mcp-cloudrun"
      ]
    }
  }
}